# Copy to .env.local for local development. Never commit real environment files.
# Every VITE_* value is embedded in the public JavaScript bundle: never put secrets here.

# Development: the Vite dev server forwards /api to this backend (no CORS involved). Default shown.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Production (Vercel): the public base URL of the deployed API, without a trailing slash, e.g.
# VITE_API_URL=https://instalytics-api.onrender.com
# The backend must list this app's origin in its CORS_ORIGINS. Without it, production builds show no API status
# and everything else still works. Vite reads it at build time, so redeploy after changing it.
# No Instagram data is ever sent to the backend: exports are read and analysed in the browser, and today the app
# only calls GET /api/v1/health/ready.
# VITE_API_URL=
