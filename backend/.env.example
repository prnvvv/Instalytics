# Copy to .env for local development. Never commit a real .env file.
# Instalytics never needs Instagram credentials; do not add any here.

APP_ENV=development
LOG_LEVEL=INFO
# JSON logs for production/containers; set false for human-readable local output.
LOG_JSON=true

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:5173

# Optional. When set, GET /api/v1/health/ready verifies Redis connectivity.
# REDIS_URL=redis://localhost:6379/0

# Request limits for the stateless JSON API
# MAX_REQUEST_BODY_BYTES=20971520
# MAX_ACCOUNTS_PER_LIST=200000

# ZIP validation limits used by the archive module
# ARCHIVE_MAX_BYTES=262144000
# ARCHIVE_MAX_ENTRIES=10000
# ARCHIVE_MAX_ENTRY_BYTES=209715200
# ARCHIVE_MAX_TOTAL_BYTES=1073741824
# ARCHIVE_MAX_COMPRESSION_RATIO=100
# ARCHIVE_MAX_JSON_BYTES=52428800
